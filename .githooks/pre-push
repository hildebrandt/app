#!/bin/sh
set -eu

budget=480

if ! command -v timeout >/dev/null 2>&1; then
  echo "timeout is required for the mutation runtime budget." >&2
  exit 1
fi

echo "Running mutation gate: break 100, runtime budget ${budget}s."

timeout "$budget" pnpm mutation || {
  status=$?

  if [ "$status" -eq 124 ]; then
    echo "Mutation gate exceeded the ${budget}s runtime budget." >&2
  fi

  exit "$status"
}
