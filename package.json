{
  "name": "app",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "vp fmt",
    "check-types": "turbo run check-types",
    "test": "turbo run test",
    "test:coverage": "turbo run test && turbo run coverage",
    "coverage": "node scripts/merge-coverage.mjs && vp test run --mergeReports coverage/blob-merged --coverage",
    "mutation": "turbo run mutation",
    "check": "ultracite check",
    "fix": "ultracite fix"
  },
  "devDependencies": {
    "@interfere/landmines": "^0.3.1",
    "@shadcn/lint": "^0.2.5",
    "@vitest/coverage-v8": "5.1.1",
    "eslint-plugin-github": "^6.1.2",
    "eslint-plugin-jsdoc": "^65.5.4",
    "eslint-plugin-sonarjs": "^4.2.2",
    "eslint-plugin-tsdoc": "^0.5.4",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "oxlint-plugin-react-doctor": "^0.9.23",
    "oxlint-tsgolint": "^7.0.2008",
    "turbo": "^2.11.13",
    "typescript": "7.0.2",
    "ultracite": "8.3.1",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.25.0"
}
