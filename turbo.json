{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": ["dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vite.config.ts"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vite.config.ts",
        "$TURBO_ROOT$/vitest.shared.ts"
      ],
      "outputs": ["coverage/**", "reports/test/**"]
    },
    "//#coverage": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vite.config.ts",
        "$TURBO_ROOT$/vitest.shared.ts",
        {
          "mode": "jit",
          "globs": ["apps/*/coverage/blob/**"]
        }
      ],
      "outputs": ["coverage/**"]
    },
    "//#fallow": {
      "cache": false
    },
    "e2e": {
      "dependsOn": ["^build", "e2e:install"],
      "env": ["PLAYWRIGHT_BASE_URL"],
      "passThroughEnv": ["PLAYWRIGHT_*"],
      "outputs": [
        "playwright-report/**",
        "reports/playwright/**",
        "test-results/**"
      ]
    },
    "e2e:install": {
      "cache": false,
      "passThroughEnv": ["PLAYWRIGHT_*"]
    },
    "mutation": {
      "dependsOn": ["build"],
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
